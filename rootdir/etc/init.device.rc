service nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.st
    override
    class hal
    user nfc
    group nfc
    disabled

on boot && property:ro.boot.product.hardware.sku=moonstone_p_global
    enable nfc_hal_service

on boot && property:ro.boot.product.hardware.sku=sunstone_global
    enable nfc_hal_service
